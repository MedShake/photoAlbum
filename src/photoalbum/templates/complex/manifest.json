{
  "schema_version": 1,
  "id": "complex",
  "name": "Complex",
  "version": "1.4.0",
  "authors": [
    {
      "name": "Bertrand Boutillier"
    }
  ],
  "description": "Autonomous 1–5 photo pack: 4-photo Reportage unchanged; 29 chronological 5-photo Mosaïque/Sequence layouts; per-signature deterministic automatic rotation (host integration).",
  "documentation": {
    "en": "docs/help.en.html",
    "fr": "docs/help.fr.html"
  },
  "templates": [
    {
      "id": "complex-photo-1",
      "name": "One photo",
      "module": "photoalbum.templates.complex.photo_page",
      "kinds": [
        "photo_page"
      ],
      "photo_capacity": 1
    },
    {
      "id": "complex-photo-2",
      "name": "Two photos",
      "module": "photoalbum.templates.complex.photo_page",
      "kinds": [
        "photo_page"
      ],
      "photo_capacity": 2
    },
    {
      "id": "complex-photo-3",
      "name": "Three photos",
      "module": "photoalbum.templates.complex.photo_page",
      "kinds": [
        "photo_page"
      ],
      "photo_capacity": 3
    },
    {
      "id": "complex-photo-4",
      "name": "Four photos",
      "module": "photoalbum.templates.complex.photo_page",
      "kinds": [
        "photo_page"
      ],
      "photo_capacity": 4
    },
    {
      "id": "complex-photo-5",
      "name": "Five photos",
      "module": "photoalbum.templates.complex.photo_page",
      "kinds": [
        "photo_page"
      ],
      "photo_capacity": 5
    }
  ],
  "automatic_photo_page_modes": [
    {
      "id": "complex-auto-1-5",
      "name": "Automatic mode — 1 to 5 photos",
      "module": "photoalbum.templates.complex.photo_page",
      "selector": "photoalbum.templates.complex.photo_page.automatic:select_automatic_1_5",
      "templates": [
        "complex-photo-1",
        "complex-photo-2",
        "complex-photo-3",
        "complex-photo-4",
        "complex-photo-5"
      ],
      "settings_template": "complex-photo-1"
    }
  ],
  "default_templates": {
    "photo_page": "complex-auto-1-5"
  }
}
