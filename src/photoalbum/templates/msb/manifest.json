{
  "schema_version": 1,
  "id": "msb",
  "name": "MSB",
  "version": "1.0",
  "authors": [
    {
      "name": "MSB"
    }
  ],
  "description": "Templates historiques fournis avec Photo Album.",
  "documentation": {
    "en": "docs/help.en.html",
    "fr": "docs/help.fr.html"
  },
  "templates": [
    {
      "id": "year-photo-scatter",
      "name": "Year photo scatter",
      "module": "photoalbum.templates.msb.year_photo_scatter",
      "kinds": [
        "cover",
        "special_page"
      ],
      "cover_positions": [
        "front",
        "inside_front",
        "inside_back",
        "back"
      ]
    },
    {
      "id": "geographic-word-cloud",
      "name": "Geographic word cloud",
      "module": "photoalbum.templates.msb.geographic_word_cloud",
      "kinds": [
        "cover",
        "special_page"
      ],
      "cover_positions": [
        "front",
        "inside_front",
        "inside_back",
        "back"
      ]
    },
    {
      "id": "calendar-index",
      "name": "Annual calendar",
      "module": "photoalbum.templates.msb.calendar_index",
      "kinds": [
        "cover",
        "special_page",
        "year_divider"
      ],
      "cover_positions": [
        "front",
        "inside_front",
        "inside_back",
        "back"
      ],
      "page_constraints": {
        "min_width_mm": 180,
        "min_height_mm": 180
      }
    },
    {
      "id": "year-divider-classic",
      "name": "Simple year divider",
      "module": "photoalbum.templates.msb.year_divider_classic",
      "kinds": [
        "year_divider"
      ]
    },
    {
      "id": "month-divider-classic",
      "name": "Month divider with city list",
      "module": "photoalbum.templates.msb.month_divider_classic",
      "kinds": [
        "month_divider"
      ],
      "page_constraints": {
        "min_width_mm": 130,
        "min_height_mm": 145
      }
    },
    {
      "id": "month-divider-simple",
      "name": "Simple month divider",
      "module": "photoalbum.templates.msb.month_divider_simple",
      "kinds": [
        "month_divider"
      ]
    },
    {
      "id": "photo-page-1",
      "name": "One photo",
      "module": "photoalbum.templates.msb.photo_page",
      "kinds": [
        "photo_page"
      ],
      "photo_capacity": 1
    },
    {
      "id": "photo-page-2",
      "name": "Two photos",
      "module": "photoalbum.templates.msb.photo_page",
      "kinds": [
        "photo_page"
      ],
      "photo_capacity": 2
    },
    {
      "id": "photo-page-3",
      "name": "Three photos",
      "module": "photoalbum.templates.msb.photo_page",
      "kinds": [
        "photo_page"
      ],
      "photo_capacity": 3
    },
    {
      "id": "photo-page-4",
      "name": "Four photos",
      "module": "photoalbum.templates.msb.photo_page",
      "kinds": [
        "photo_page"
      ],
      "photo_capacity": 4
    },
    {
      "id": "dedication",
      "name": "Dedication",
      "module": "photoalbum.templates.msb.dedication",
      "kinds": [
        "special_page",
        "cover"
      ],
      "cover_positions": [
        "inside_front",
        "inside_back",
        "back"
      ]
    },
    {
      "id": "blank",
      "name": "Blank page",
      "module": "photoalbum.templates.msb.blank",
      "kinds": [
        "special_page"
      ]
    }
  ],
  "settings_editor": "photoalbum.templates.msb:edit_settings",
  "default_templates": {
    "front_cover": "year-photo-scatter",
    "inside_front_cover": "geographic-word-cloud",
    "inside_back_cover": "dedication",
    "back_cover": "geographic-word-cloud",
    "photo_page": "photo-page-2",
    "year_divider": "calendar-index",
    "month_divider": "month-divider-classic"
  }
}
